# Copia este archivo como .env.local y rellénalo (Supabase → Project Settings → API Keys).
# Sin estas dos, la app arranca en «modo demo»: guarda en este navegador, no en Supabase.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_KEY=sb_publishable_xxxxxxxx

# IA de la captura (api/capture.ts). "mock" (o sin GEMINI_API_KEY) = respuestas de prueba sin clave ni coste.
# Con "gemini", la clave de Google AI Studio va en GEMINI_API_KEY (y en Vercel, nunca en git).
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Alternativa para el texto: AI_PROVIDER=deepseek y la clave de platform.deepseek.com (de pago, céntimos).
# Fotos y voz siguen yendo a Gemini si hay GEMINI_API_KEY.
DEEPSEEK_API_KEY=
# Opcional: si pones ids de usuario (separados por comas), solo ellos pueden usar la IA (beta cerrada).
# Vacío = cualquiera con cuenta, con el límite diario AI_DAILY_LIMIT (por defecto 20 al día).
AI_ALLOWED_USERS=

# Avisos push (api/tick.ts, api/ping.ts). Par de claves: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Solo en Vercel: la clave secreta de Supabase (Project Settings → API Keys → Secret keys) y una contraseña
# larga inventada que el cron de Supabase manda a /api/tick (la misma va en supabase/cron.sql).
SUPABASE_SECRET_KEY=
CRON_SECRET=

# Anti-bots en la entrada (Cloudflare Turnstile, gratis). Vacío = apagado. Ver README antes de activarlo en Supabase.
VITE_TURNSTILE_SITE_KEY=
